---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Tekmera | Real value from AI, starting with your data",
  description = "Tekmera designs and builds governed data and AI platforms for healthcare, life sciences and public health — on your data, in your environment.",
} = Astro.props;
const url = new URL(Astro.url.pathname, "https://tekmeradata.ai").toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div style="font-family: var(--font-body); color: #F4EEE2; width: 100%; background: radial-gradient(1200px 700px at 85% 14%, rgba(40,70,190,0.16), transparent 60%), radial-gradient(1100px 800px at 8% 36%, rgba(91,140,255,0.09), transparent 60%), radial-gradient(1200px 800px at 92% 58%, rgba(60,100,200,0.10), transparent 60%), radial-gradient(1000px 700px at 15% 80%, rgba(91,140,255,0.07), transparent 60%), linear-gradient(180deg, #0A0F1A 0%, #0B1322 25%, #0B1226 50%, #0B1222 72%, #06080E 100%)">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // Fade sections in as they scroll into view (skipped for reduced-motion users)
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce && "IntersectionObserver" in window) {
        const targets = [];
        document.querySelectorAll("main section:not([data-no-reveal])").forEach((section) => {
          const container = section.querySelector(":scope > div:last-of-type") || section;
          Array.from(container.children).forEach((el) => {
            // stagger items inside grids and lists
            const grid = el.matches("ol, ul") || getComputedStyle(el).display === "grid";
            if (grid) {
              Array.from(el.children).forEach((child, i) => {
                child.style.transitionDelay = `${Math.min(i, 5) * 90}ms`;
                targets.push(child);
              });
            } else {
              targets.push(el);
            }
          });
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        targets.forEach((t) => {
          t.classList.add("reveal");
          io.observe(t);
        });
      }
    </script>
  </body>
</html>
