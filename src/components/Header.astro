<span style="font-size: 20px; font-weight: 700; letter-spacing: 0.06em">TEKMERA</span>
</a>
<nav aria-label="Primary" style="display: flex; flex-wrap: wrap; align-items: center; gap: 28px; font-size: 15px">
<a href="/#services" style="color: #D8D1C3; text-decoration: none">Services</a>
<a href="/#industries" style="color: #D8D1C3; text-decoration: none">Industries</a>
<a href="/#products" style="color: #D8D1C3; text-decoration: none">Products</a>
