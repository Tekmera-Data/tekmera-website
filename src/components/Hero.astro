---
// Hero: optional background video (public/video/hero.mp4) over an animated
// "data flowing into value" canvas. If the video file is missing, the canvas
// animation shows on its own.
const videoSrc = "/video/hero.mp4";
---
<section id="top" data-no-reveal class="hero" style="position: relative; overflow: hidden; padding: 120px 24px; min-height: min(calc(100vh - 69px), 920px); box-sizing: border-box; display: flex; align-items: center">

  <!-- Layer 1: animated light streams (always available, no assets needed) -->
  <canvas id="hero-flow" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%"></canvas>

  <!-- Layer 2: optional silent video loop -->
  <video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s ease">
    <source src={videoSrc} type="video/mp4" />
  </video>

  <!-- Layer 3: legibility veil + soft fade into the next section -->
  <div aria-hidden="true" style="position: absolute; inset: 0; background: radial-gradient(60% 55% at 50% 48%, rgba(10,15,26,0.78) 0%, rgba(10,15,26,0.35) 60%, rgba(10,15,26,0) 100%), linear-gradient(180deg, rgba(10,15,26,0.0) 70%, rgba(11,19,34,1) 100%)"></div>

  <div style="position: relative; max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center">
    <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: 0.18em; color: #2DD4BF; font-weight: 700"><span style="width: 6px; height: 6px; border-radius: 50%; background: #2DD4BF"></span>YOUR DATA · REAL AI VALUE</div>
    <h1 style="margin: 0; font-size: clamp(42px, 6.6vw, 88px); line-height: 1.03; font-weight: 700; color: #FFFFFF; letter-spacing: -0.03em">Real value from AI.<br><span style="color: #5EEAD4">Starting with your data.</span></h1>
    <p style="margin: 0; font-size: 20px; line-height: 1.6; color: #D3DAE6; max-width: 740px">Most AI initiatives stall before they pay off — not because of the models, but because the data underneath isn't ready. Tekmera builds the governed foundation and the AI use cases on top of it, in your environment, so value shows up in production, not just in pilots.</p>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px; padding-top: 6px">
      <a href="/#contact" style="background: #2DD4BF; color: #04201C; text-decoration: none; font-weight: 700; padding: 18px 32px; border-radius: 999px; font-size: 14px; letter-spacing: 0.12em">TALK TO AN EXPERT</a>
      <a href="/#services" style="color: #E6EAF2; text-decoration: underline; text-underline-offset: 5px; font-weight: 700; font-size: 15px">Explore our services</a>
    </div>
  </div>

  <!-- scroll cue -->
  <a href="/#services" aria-label="Scroll to services" class="scroll-cue" style="position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); width: 28px; height: 44px; border: 2px solid rgba(255,255,255,0.35); border-radius: 14px; display: flex; justify-content: center; padding-top: 8px; box-sizing: border-box">
    <span style="width: 4px; height: 8px; border-radius: 2px; background: #5EEAD4"></span>
  </a>
</section>

<style>
  .scroll-cue span { animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(12px); opacity: 0; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue span { animation: none; }
    .hero-video { display: none; }
  }
</style>

<script>
  // ---- Optional video: fade in only if the file actually loads
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const canvas = document.getElementById("hero-flow") as HTMLCanvasElement | null;
  if (video) {
    video.addEventListener("loadeddata", () => {
      video.style.opacity = "0.55";
      if (canvas) canvas.style.opacity = "0.35";
    });
    video.addEventListener("error", () => video.remove(), true);
  }

  // ---- Canvas: streams of light converging toward the centre ("data into value")
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let w = 0, h = 0, dpr = 1, running = true;
    type P = { x: number; base: number; speed: number; amp: number; freq: number; phase: number; size: number; color: string };
    let parts: P[] = [];
    const colors = ["94,234,212", "45,212,191", "96,165,250", "56,189,248"];

    const spawn = (randomX: boolean): P => ({
      x: randomX ? Math.random() * w : -10,
      base: Math.random() * h,
      speed: 0.35 + Math.random() * 0.9,
      amp: 10 + Math.random() * 40,
      freq: 0.002 + Math.random() * 0.004,
      phase: Math.random() * Math.PI * 2,
      size: 0.6 + Math.random() * 1.6,
      color: colors[Math.floor(Math.random() * colors.length)],
    });

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = w < 700 ? 70 : 170;
      parts = Array.from({ length: n }, () => spawn(true));
      ctx.fillStyle = "#0A0F1A"; ctx.fillRect(0, 0, w, h);
    };

    const yOf = (p: P) => {
      const t = Math.min(p.x / w, 1);
      const pull = t * t * (3 - 2 * t);           // smoothstep: streams gather toward the middle
      const cy = h * 0.5;
      return p.base + (cy - p.base) * pull * 0.55 + Math.sin(p.x * p.freq + p.phase) * p.amp * (1 - pull * 0.6);
    };

    const frame = () => {
      ctx.fillStyle = "rgba(10,15,26,0.12)";       // fade old frames -> light trails
      ctx.fillRect(0, 0, w, h);
      for (const p of parts) {
        p.x += p.speed;
        if (p.x > w + 10) Object.assign(p, spawn(false));
        const y = yOf(p);
        const fade = Math.sin(Math.min(p.x / w, 1) * Math.PI); // dim at the edges
        ctx.beginPath();
        ctx.fillStyle = `rgba(${p.color},${0.15 + 0.75 * fade})`;
        ctx.arc(p.x, y, p.size, 0, Math.PI * 2);
        ctx.fill();
      }
      if (running && !reduce) requestAnimationFrame(frame);
    };

    resize();
    window.addEventListener("resize", resize);
    if (reduce) {
      for (let i = 0; i < 120; i++) frame();       // draw one settled still frame
    } else {
      frame();
      // pause when the hero is off-screen
      new IntersectionObserver(([e]) => {
        const was = running; running = e.isIntersecting;
        if (running && !was) requestAnimationFrame(frame);
      }).observe(canvas);
    }
  }
</script>
