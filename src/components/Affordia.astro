---
// Affordia product teaser — strategic, outcome-level only (no method details)
const outcomes = [
  {
    title: "Visibility",
    text: "See where every patient-assistance dollar actually goes.",
    icon: '<circle cx="12" cy="12" r="3"></circle><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path>',
  },
  {
    title: "Confidence",
    text: "Act on findings your teams can stand behind.",
    icon: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path><path d="M9 12l2 2 4-4"></path>',
  },
  {
    title: "Impact",
    text: "Put recovered dollars back to work for patients.",
    icon: '<path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"></path>',
  },
];
---
<section id="products" style="position: relative; padding: 128px 24px">
<div style="max-width: 1120px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">

<div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: 0.16em; color: #2DD4BF; font-weight: 700"><span style="width: 6px; height: 6px; border-radius: 50%; background: #2DD4BF"></span>AFFORDIA™ BY TEKMERA · EARLY ACCESS</div>
<h2 style="margin: 0; font-size: clamp(36px, 4.8vw, 60px); line-height: 1.06; letter-spacing: -0.02em; color: #FFFFFF; font-weight: 700">Affordability that<br><span style="color: #5EEAD4">reaches the patient.</span></h2>
<p style="margin: 0; font-size: 18px; line-height: 1.65; color: #C3CBDA; max-width: 560px">Patient assistance only works when it reaches the patients it was meant for. Affordia helps manufacturers protect the impact of their affordability programs — so more support ends up where it belongs.</p>
<p style="margin: 0; font-size: 15px; line-height: 1.6; color: #94A3B8; max-width: 560px">Built for patient services, market access and compliance leaders.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px; padding-top: 6px">
<a href="/#contact" style="background: #2DD4BF; color: #04201C; text-decoration: none; font-weight: 700; padding: 16px 28px; border-radius: 999px; font-size: 14px; letter-spacing: 0.12em">BECOME A DESIGN PARTNER</a>
<a href="/#contact" style="color: #E6EAF2; font-weight: 700; font-size: 15px; text-decoration: underline; text-underline-offset: 5px">Request a briefing</a>
</div>
</div>

<div style="flex: 1 1 440px; min-width: 0; position: relative; border-radius: 22px; padding: 28px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.10); overflow: hidden; display: flex; flex-direction: column; gap: 18px">
<svg aria-hidden="true" viewBox="0 0 480 260" style="width: 100%; height: auto; display: block">
<defs>
<radialGradient id="aff-core" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#2DD4BF" stop-opacity="0.45"></stop><stop offset="100%" stop-color="#2DD4BF" stop-opacity="0"></stop></radialGradient>
<filter id="aff-blur"><feGaussianBlur stdDeviation="40"></feGaussianBlur></filter>
</defs>
<g filter="url(#aff-blur)"><ellipse cx="380" cy="40" rx="140" ry="80" fill="#1D4ED8" fill-opacity="0.45"></ellipse><ellipse cx="80" cy="230" rx="140" ry="70" fill="#2DD4BF" fill-opacity="0.18"></ellipse></g>
<circle cx="360" cy="130" r="92" fill="url(#aff-core)"></circle>
<g fill="none" stroke="#2DD4BF" stroke-opacity="0.22" stroke-width="1.2">
<path id="aff-p1" d="M20 40 C 140 40, 230 110, 360 130"></path>
<path id="aff-p2" d="M20 130 C 140 130, 240 130, 360 130"></path>
<path id="aff-p3" d="M20 220 C 140 220, 230 150, 360 130"></path>
<path d="M200 110 C 230 70, 250 40, 300 20" stroke-dasharray="3 5" stroke-opacity="0.35"></path>
</g>
<g fill="#5EEAD4">
<circle r="4"><animateMotion dur="4s" repeatCount="indefinite"><mpath href="#aff-p1"></mpath></animateMotion></circle>
<circle r="4"><animateMotion dur="4s" begin="1.3s" repeatCount="indefinite"><mpath href="#aff-p2"></mpath></animateMotion></circle>
<circle r="4"><animateMotion dur="4s" begin="2.6s" repeatCount="indefinite"><mpath href="#aff-p3"></mpath></animateMotion></circle>
<circle r="4"><animateMotion dur="4s" begin="0.7s" repeatCount="indefinite"><mpath href="#aff-p2"></mpath></animateMotion></circle>
</g>
<circle cx="300" cy="20" r="4" fill="#F59E0B"><animate attributeName="opacity" values="0;1;0" dur="3s" repeatCount="indefinite"></animate></circle>
<circle cx="360" cy="130" r="34" fill="#0B1222" stroke="#2DD4BF" stroke-width="2"></circle>
<circle cx="360" cy="130" r="44" fill="none" stroke="#2DD4BF" stroke-opacity="0.4"><animate attributeName="r" values="38;54;38" dur="3.5s" repeatCount="indefinite"></animate><animate attributeName="stroke-opacity" values="0.5;0;0.5" dur="3.5s" repeatCount="indefinite"></animate></circle>
<g stroke="#5EEAD4" stroke-width="2" fill="none" stroke-linecap="round"><circle cx="360" cy="121" r="7"></circle><path d="M346 146c2-8 8-12 14-12s12 4 14 12"></path></g>
<text x="360" y="196" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="700" letter-spacing="2" fill="#94A3B8">THE PATIENT</text>
</svg>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px">
{outcomes.map((o) => (
<li style="display: flex; gap: 16px; align-items: center; padding: 16px 18px; border-radius: 14px; background: rgba(10,15,26,0.6); border: 1px solid rgba(255,255,255,0.08)">
<span style="flex: none; width: 40px; height: 40px; border-radius: 10px; background: rgba(45,212,191,0.12); display: flex; align-items: center; justify-content: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5EEAD4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={o.icon}></svg>
</span>
<span style="display: flex; flex-direction: column; gap: 2px"><span style="font-size: 16px; font-weight: 700; color: #FFFFFF">{o.title}</span><span style="font-size: 14px; color: #A9B3C6; line-height: 1.5">{o.text}</span></span>
</li>
))}
</ul>
</div>

</div>
</section>
