---
// Contact section
---
<section id="contact" style="position: relative; overflow: hidden; padding: 120px 24px">
<svg aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" style="position: absolute; inset: 0; width: 100%; height: 100%; -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);">
<defs>
<filter id="haze" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="55"></feGaussianBlur></filter>
<filter id="streak" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="22 6"></feGaussianBlur></filter>
<filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter>
<linearGradient id="fadeR" x1="0" x2="1" y1="0" y2="0"><stop offset="0%" stop-color="#06080E" stop-opacity="0.6"></stop><stop offset="45%" stop-color="#06080E" stop-opacity="0.1"></stop><stop offset="100%" stop-color="#06080E" stop-opacity="0.4"></stop></linearGradient>
</defs>
<g filter="url(#haze)">
<ellipse cx="640" cy="520" rx="220" ry="320" fill="#B4581F" fill-opacity="0.55"></ellipse>
<ellipse cx="560" cy="300" rx="120" ry="160" fill="#E2A66B" fill-opacity="0.35"></ellipse>
<ellipse cx="1120" cy="260" rx="200" ry="380" fill="#6F9FB3" fill-opacity="0.35" transform="rotate(-25 1120 260)"></ellipse>
<ellipse cx="300" cy="820" rx="300" ry="160" fill="#5B8CFF" fill-opacity="0.15"></ellipse>
</g>
<g filter="url(#streak)" transform="rotate(-18 700 450)">
<rect x="430" y="380" width="420" height="26" rx="13" fill="#F1C48E" fill-opacity="0.35"></rect>
<rect x="500" y="460" width="360" height="18" rx="9" fill="#D9874A" fill-opacity="0.35"></rect>
<rect x="470" y="540" width="300" height="14" rx="7" fill="#F1C48E" fill-opacity="0.22"></rect>
<rect x="980" y="200" width="320" height="30" rx="15" fill="#BFD9E4" fill-opacity="0.25"></rect>
</g>
<rect width="1440" height="900" fill="url(#fadeR)"></rect>
<rect width="1440" height="900" filter="url(#grain)" opacity="0.07"></rect>
</svg>
<div style="position: relative; max-width: 1120px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; justify-content: space-between">
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 22px; padding-top: 12px">
<div style="display: flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: 0.16em; font-weight: 700; color: #F4EEE2"><span style="width: 6px; height: 6px; background: #5B8CFF"></span>CONTACT US</div>
<h2 style="margin: 0; font-size: clamp(36px, 4.6vw, 60px); line-height: 1.08; color: #F4EEE2; letter-spacing: -0.02em; font-weight: 700">See what your data can do.<br>Talk to an expert.</h2>
<p style="margin: 0; font-size: 18px; line-height: 1.6; color: #D8D1C3; max-width: 460px">Tell us where your data and AI program stands. We will come back within one business day with a suggested next step.</p>
</div>
<form name="contact" method="POST" data-netlify="true" action="/success" netlify-honeypot="company_website" aria-label="Contact" style="flex: 1 1 480px; min-width: 0; max-width: 620px; background: rgba(30,34,42,0.55); border: 1px solid rgba(255,255,255,0.14); border-radius: 18px; padding: 28px; display: flex; flex-direction: column; gap: 20px; backdrop-filter: blur(18px)">
<p hidden><label>Leave blank <input name="company_website"></label></p>
<input type="hidden" name="form-name" value="contact">
<div style="display: flex; flex-wrap: wrap; gap: 16px">
<label style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; color: #F4EEE2; flex: 1 1 200px; min-width: 0">First name<input type="text" name="first_name" required placeholder="First name" style="width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 15px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #F4EEE2"></label>
<label style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; color: #F4EEE2; flex: 1 1 200px; min-width: 0">Last name<input type="text" name="last_name" required placeholder="Last name" style="width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 15px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #F4EEE2"></label>
</div>
<label style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; color: #F4EEE2; flex: 1 1 200px; min-width: 0">Work email<input type="email" name="email" required placeholder="name@company.com" style="width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 15px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #F4EEE2"></label>
<label style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; color: #F4EEE2; flex: 1 1 200px; min-width: 0">Organization<input type="text" name="organization" placeholder="Organization" style="width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 15px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #F4EEE2"></label>
<label style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; color: #F4EEE2; flex: 1 1 200px; min-width: 0">Industry<select name="industry" style="width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 15px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #F4EEE2; appearance: none; background-image: linear-gradient(45deg, transparent 50%, #D8D1C3 50%), linear-gradient(135deg, #D8D1C3 50%, transparent 50%); background-position: calc(100% - 22px) 22px, calc(100% - 16px) 22px; background-size: 6px 6px; background-repeat: no-repeat"><option>Select industry</option><option>Healthcare</option><option>Life sciences</option><option>Public health</option><option>Other enterprise</option></select></label>
<label style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; color: #F4EEE2; flex: 1 1 200px; min-width: 0">How can we help?<textarea name="message" rows="4" placeholder="Tell us about your goals…" style="width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); border-radius: 10px; padding: 15px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #F4EEE2; resize: vertical"></textarea></label>
<label style="display: flex; gap: 12px; align-items: flex-start; font-size: 13px; line-height: 1.5; color: #D8D1C3"><input type="checkbox" name="email_updates" value="yes" style="width: 18px; height: 18px; margin: 1px 0 0; accent-color: #5B8CFF">I agree to receive occasional email updates from Tekmera.</label>
<button type="submit" style="background: #5B8CFF; color: #0B1020; border: 0; border-radius: 10px; padding: 16px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; font-weight: 700; cursor: pointer">Book a consultation</button>
</form>
</div>
</section>
